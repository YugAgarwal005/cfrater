# ============================================================
# CF Rating Predictor — Environment Variables
# Copy this file to .env and adjust as needed
# ============================================================

# Model directory (where trained models are stored)
MODEL_DIR=models/

# Flask settings
FLASK_PORT=5000
FLASK_DEBUG=false

# Codeforces API key (optional, for higher rate limits)
# CF_API_KEY=your_key_here
# CF_API_SECRET=your_secret_here

# Sentence transformer model (change for larger/faster embeddings)
# Options: all-MiniLM-L6-v2 (fast), all-mpnet-base-v2 (accurate)
EMBEDDING_MODEL=all-MiniLM-L6-v2
